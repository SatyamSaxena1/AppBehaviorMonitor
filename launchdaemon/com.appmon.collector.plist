<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.appmon.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/local/bin/python3.14</string>
        <string>/var/jb/var/mobile/appmon/collector.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/var/jb/var/mobile/appmon</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/var/mobile/Documents/appmon/collector.log</string>
    <key>StandardOutPath</key>
    <string>/var/jb/var/mobile/Documents/appmon/collector.log</string>
    <key>UserName</key>
    <string>mobile</string>
</dict>
</plist>
